# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database - use sqlite for development / mysql for production
DB_DRIVER=sqlite
DB_FILE=./data/dbm-lite.db
# DB_DSN=root:password@tcp(127.0.0.1:3306)/dbm_lite?charset=utf8mb4&parseTime=True&loc=Local

# Security - PLEASE CHANGE THESE IN PRODUCTION
JWT_SECRET=dbm-lite-jwt-secret-key-change-in-production-please-12345
JWT_EXPIRE_HOURS=168
ENCRYPT_KEY=dbm-lite-encrypt-key-32bytes-long-please-

# Default Admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@example.com
